<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LlamaCppStarterApp.ViewModels"
             xmlns:models="clr-namespace:LlamaCppStarterApp.Models"
             xmlns:controls="clr-namespace:LlamaCppStarterApp.Controls"
             x:DataType="vm:ModelsViewModel"
             x:Class="LlamaCppStarterApp.Views.ModelsPage"
             Title="Models">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20,16">

        <!-- Topbar: scan / pick folder / path -->
        <Border Grid.Row="0" Style="{StaticResource PanelBorder}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <Button Grid.Column="0"
                        Text="Scan Models"
                        SemanticProperties.Hint="Scan the models folder for GGUF files"
                        Command="{Binding ScanModelsCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                <Button Grid.Column="1"
                        Text="Browse"
                        Style="{StaticResource RowButton}"
                        Margin="8,0,0,0"
                        VerticalOptions="Center"
                        SemanticProperties.Hint="Choose a different models folder"
                        Command="{Binding ChooseFolderCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                <Label Grid.Column="2"
                       Text="{Binding FolderPath}"
                       FontFamily="Consolas"
                       FontSize="13"
                       VerticalOptions="Center"
                       LineBreakMode="CharacterWrap"
                       Margin="12,0" />
                <ActivityIndicator Grid.Column="3"
                                   IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                                   VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Middle: tables on the left, launch settings on the right -->
        <Grid Grid.Row="1" ColumnDefinitions="*,440" Margin="0,12,0,0" ColumnSpacing="12">

            <!-- Left column: model files + launch profiles -->
            <Grid Grid.Column="0" RowDefinitions="*,Auto" RowSpacing="12">

                <!-- Model files -->
                <Border Grid.Row="0" Style="{StaticResource PanelBorder}">
                    <Grid RowDefinitions="Auto,Auto,Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                            <BoxView Grid.Column="0"
                                     WidthRequest="4"
                                     HeightRequest="20"
                                     CornerRadius="2"
                                     BackgroundColor="{StaticResource Primary}"
                                     Margin="0,0,10,0"
                                     VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="Model Files"
                                   Style="{StaticResource SectionTitle}" />
                        </Grid>
                        <Label Grid.Row="1"
                               Text="GGUF files found in the models folder or imported from elsewhere."
                               Style="{StaticResource SectionSubtitle}"
                               Margin="14,4,0,0" />

                        <Grid Grid.Row="2"
                              ColumnDefinitions="4*,Auto,Auto,Auto,Auto"
                              Margin="0,12,0,4">
                            <Label Grid.Column="0" Text="Name" Style="{StaticResource TableHeaderLabel}" />
                            <Label Grid.Column="1" Text="Quant" Style="{StaticResource TableHeaderLabel}" />
                            <Label Grid.Column="2" Text="Size" Style="{StaticResource TableHeaderLabel}" />
                            <Label Grid.Column="3" Text="Open Folder" Style="{StaticResource TableHeaderLabel}" />
                            <Label Grid.Column="4" Text="Remove" Style="{StaticResource TableHeaderLabel}" />
                        </Grid>

                        <CollectionView Grid.Row="3"
                                        ItemsSource="{Binding Models}"
                                        SelectionMode="Single"
                                        SelectedItem="{Binding SelectedModel}"
                                        VerticalScrollBarVisibility="Always">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Model">
                                    <Border Style="{StaticResource TableRowBorder}">
                                        <Grid ColumnDefinitions="4*,Auto,Auto,Auto,Auto">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   Style="{StaticResource TableCell}"
                                                   FontAttributes="Bold" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding Quant}"
                                                   Style="{StaticResource TableCell}"
                                                   Margin="8,0" />
                                            <Label Grid.Column="2"
                                                   Text="{Binding SizeBytes, Converter={StaticResource SizeToGbConverter}}"
                                                   Style="{StaticResource TableCell}"
                                                   Margin="8,0" />
                                            <Button Grid.Column="3"
                                                    Text="Open Folder"
                                                    Style="{StaticResource RowButton}"
                                                    Margin="8,0"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenFolderCommand}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Grid.Column="4"
                                                    Text="Delete"
                                                    Style="{StaticResource DangerButton}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteModelCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Border>

                <!-- Launch profiles (per model) -->
                <Border Grid.Row="1" Style="{StaticResource PanelBorder}">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                            <BoxView Grid.Column="0"
                                     WidthRequest="4"
                                     HeightRequest="20"
                                     CornerRadius="2"
                                     BackgroundColor="{StaticResource Primary}"
                                     Margin="0,0,10,0"
                                     VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="Launch Profiles"
                                   Style="{StaticResource SectionTitle}" />
                            <Button Grid.Column="2"
                                    Text="Add"
                                    Style="{StaticResource RowButton}"
                                    VerticalOptions="Center"
                                    SemanticProperties.Hint="New profile for the selected model"
                                    Command="{Binding AddProfileCommand}" />
                        </Grid>
                        <Label Grid.Row="1"
                               Text="Loadable variants of launch settings."
                               Style="{StaticResource SectionSubtitle}"
                               Margin="14,4,0,8" />

                        <Grid Grid.Row="2"
                              ColumnDefinitions="2*,3*,Auto,Auto,Auto"
                              Margin="0,0,0,4">
                            <Label Grid.Column="0" Text="Name" Style="{StaticResource TableHeaderLabel}" />
                            <Label Grid.Column="1" Text="Base Model" Style="{StaticResource TableHeaderLabel}" />
                            <Label Grid.Column="2" Text="Port" Style="{StaticResource TableHeaderLabel}" />
                            <Label Grid.Column="3" Text="Copy" Style="{StaticResource TableHeaderLabel}" />
                            <Label Grid.Column="4" Text="Remove" Style="{StaticResource TableHeaderLabel}" />
                        </Grid>

                        <CollectionView Grid.Row="3"
                                        ItemsSource="{Binding Profiles}"
                                        SelectionMode="Single"
                                        SelectedItem="{Binding SelectedProfile}"
                                        VerticalScrollBarVisibility="Always">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Profile">
                                    <Border Style="{StaticResource TableRowBorder}">
                                        <Grid ColumnDefinitions="2*,3*,Auto,Auto,Auto">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   Style="{StaticResource TableCell}"
                                                   FontAttributes="Bold" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding ModelName}"
                                                   Style="{StaticResource TableCell}"
                                                   Margin="8,0" />
                                            <Label Grid.Column="2"
                                                   Text="{Binding Port}"
                                                   Style="{StaticResource TableCell}"
                                                   Margin="8,0" />
                                            <Button Grid.Column="3"
                                                    Text="Copy"
                                                    Style="{StaticResource CopyButton}"
                                                    Margin="8,0,0,0"
                                                    SemanticProperties.Hint="Copy this profile (same model, settings, and port)"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CopyProfileCommand}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Grid.Column="4" Margin="6,0,0,0"
                                                    Text="Delete"
                                                    Style="{StaticResource DangerButton}"
                                                    IsVisible="{Binding IsDefault, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteProfileCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right column: launch settings (editable, directly bound to the selected ProfileParameters).
                 Metadata (top) and Save/Delete (bottom) stay fixed; the form in between scrolls. -->
            <Border Grid.Column="1" Style="{StaticResource PanelBorder}">
                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- Top: Metadata (capability chips) — always visible -->
                    <Grid Grid.Row="0"
                          IsVisible="{Binding SelectedModelCapabilitySummaryText, Converter={StaticResource StringToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0"
                               Text="Metadata"
                               Style="{StaticResource SectionTitle}"
                               FontSize="13" />
                        <Label Grid.Row="1"
                               Text="{Binding SelectedModelCapabilitySummaryText}"
                               FontSize="13"
                               LineBreakMode="CharacterWrap"
                               Margin="14,4,0,8" />
                    </Grid>

                    <!-- Middle (scrolls): Name + parameter sections + Runtime Command -->
                    <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Default">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          IsVisible="{Binding SelectedProfile, Converter={StaticResource NullToVisibilityConverter}}">

                            <!-- Header: Name -->
                            <Grid Grid.Row="0" ColumnDefinitions="*">
                                <Entry Grid.Column="0"
                                       Text="{Binding SelectedProfile.Name, Mode=TwoWay}"
                                       Style="{StaticResource FieldEntry}"
                                       Placeholder="Profile Name"
                                       IsVisible="{Binding SelectedProfile.IsDefault, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                            </Grid>

                            <!-- Basic launch -->
                            <Grid Grid.Row="1" Margin="0,14,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Label Grid.Row="0" Grid.ColumnSpan="2" Text="Basic Launch" Style="{StaticResource SectionTitle}" FontSize="15" Margin="0,0,0,8" />

                                <Label Grid.Row="1" Grid.Column="0" Text="Model alias" Style="{StaticResource FieldLabel}" Margin="0,0,10,4" />
                                <Entry Grid.Row="1" Grid.Column="1"
                                  Text="{Binding CurrentParameters.ModelAlias}"
                                  Style="{StaticResource FieldEntry}" Margin="0,0,0,4"
                                  Placeholder="{Binding ModelAliasDefaultPlaceholder}"
                                  SemanticProperties.Hint="-a/--alias: model name alias(es), comma-separated (for the API). Left blank = default &quot;{model name} [profile name]&quot;." />

                                <Label Grid.Row="2" Grid.Column="0" Text="Context Size" Style="{StaticResource FieldLabel}" Margin="0,0,10,4" />
                                <HorizontalStackLayout Grid.Row="2" Grid.Column="1">
                                    <Entry WidthRequest="200"
                                      Text="{Binding CurrentParameters.CtxSize, Converter={StaticResource IntNullableConverter}}"
                                      Style="{StaticResource FieldEntry}" Margin="0,0,4,4" />
                                    <Button Grid.Row="2" Grid.Column="2"
                                      Text="&#xf067;"
                                      FontFamily="FontAwesomeSolid"
                                      FontSize="12"
                                      Style="{StaticResource RowButton}"
                                      Margin="0,0,4,4"
                                      MinimumWidthRequest="32"
                                      MinimumHeightRequest="32"
                                      VerticalOptions="Center"
                                      Command="{Binding IncreaseContextSizeCommand}" />
                                    <Button Grid.Row="2" Grid.Column="3"
                                      Text="&#xf068;"
                                      FontFamily="FontAwesomeSolid"
                                      FontSize="12"
                                      Style="{StaticResource RowButton}"
                                      Margin="0,0,0,4"
                                      MinimumWidthRequest="32"
                                      MinimumHeightRequest="32"
                                      VerticalOptions="Center"
                                      Command="{Binding DecreaseContextSizeCommand}" />
                                </HorizontalStackLayout>

                                <Label Grid.Row="3" Grid.Column="0" Text="GPU mode" Style="{StaticResource FieldLabel}" Margin="0,0,10,4" />
                                <Picker Grid.Row="3" Grid.Column="1"
                                   ItemsSource="{x:Static models:ProfileParameters.SplitModeOptions}"
                                   SelectedItem="{Binding CurrentParameters.SplitMode, Converter={StaticResource PickerDefaultConverter}}"
                                   Style="{StaticResource FieldPicker}" Margin="0,0,0,4" />

                                <Label Grid.Row="4" Grid.Column="0" Text="GPU Layers" Style="{StaticResource FieldLabel}" Margin="0,0,10,4" />
                                <Entry Grid.Row="4" Grid.Column="1"
                                  Text="{Binding CurrentParameters.Ngl}"
                                  Style="{StaticResource FieldEntry}" Margin="0,0,0,4"
                                  Placeholder="e.g. 999, auto or all" />

                                <Label Grid.Row="5" Grid.Column="0" Text="Tensor split" Style="{StaticResource FieldLabel}" Margin="0,0,10,4" />
                                <Entry Grid.Row="5" Grid.Column="1"
                                  Text="{Binding CurrentParameters.TensorSplit}"
                                  Style="{StaticResource FieldEntry}" Margin="0,0,0,4"
                                  Placeholder="e.g. 24,8" />

                                <Label Grid.Row="6" Grid.Column="0" Text="Threads" Style="{StaticResource FieldLabel}" Margin="0,0,10,4" />
                                <Entry Grid.Row="6" Grid.Column="1"
                                  Text="{Binding CurrentParameters.Threads, Converter={StaticResource IntNullableConverter}}"
                                  Style="{StaticResource FieldEntry}" Margin="0,0,0,4" />

                                <Label Grid.Row="7" Grid.Column="0" Text="Host bind" Style="{StaticResource FieldLabel}" Margin="0,0,10,4" />
                                <Entry Grid.Row="7" Grid.Column="1"
                                  Text="{Binding CurrentParameters.HostBind}"
                                  Style="{StaticResource FieldEntry}" Margin="0,0,0,4"
                                  Placeholder="127.0.0.1" />

                                <Label Grid.Row="8" Grid.Column="0" Text="Port" Style="{StaticResource FieldLabel}" Margin="0,0,10,4" />
                                <Entry Grid.Row="8" Grid.Column="1"
                                  Text="{Binding SelectedProfile.Port, Converter={StaticResource IntNullableConverter}}"
                                  Style="{StaticResource FieldEntry}" Margin="0,0,0,4"
                                  Placeholder="8080" />

                                <Label Grid.Row="9" Grid.Column="0" Text="No host" Style="{StaticResource FieldLabel}" Margin="0,0,10,4" />
                                <CheckBox Grid.Row="9" Grid.Column="1"
                                      IsChecked="{Binding CurrentParameters.NoHost, Converter={StaticResource BoolNullableConverter}}"
                                      VerticalOptions="Center" Margin="0,0,0,4" />

                                <Label Grid.Row="10" Grid.Column="0" Text="Parallel (slots)" Style="{StaticResource FieldLabel}" Margin="0,0,10,4" />
                                <Entry Grid.Row="10" Grid.Column="1"
                                  Text="{Binding CurrentParameters.Parallel, Converter={StaticResource IntNullableConverter}}"
                                  Style="{StaticResource FieldEntry}" Margin="0,0,0,4" />

                                <Label Grid.Row="11" Grid.Column="0" Text="Keep" Style="{StaticResource FieldLabel}" Margin="0,0,10,4" />
                                <Entry Grid.Row="11" Grid.Column="1"
                                  Text="{Binding CurrentParameters.Keep, Converter={StaticResource IntNullableConverter}}"
                                  Style="{StaticResource FieldEntry}" Margin="0,0,0,4" />

                                <Label Grid.Row="12" Grid.Column="0" Text="Ctx checkpoints" Style="{StaticResource FieldLabel}" Margin="0,0,10,4" />
                                <Entry Grid.Row="12" Grid.Column="1"
                                  Text="{Binding CurrentParameters.CtxCheckpoints, Converter={StaticResource IntNullableConverter}}"
                                  Style="{StaticResource FieldEntry}" Margin="0,0,0,4" />
                            </Grid>

                            <!-- Performance & Memory -->
                            <Grid Grid.Row="2" Margin="0,14,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Label Grid.Row="0" Grid.ColumnSpan="2" Text="Performance &amp; Memory" Style="{StaticResource SectionTitle}" FontSize="15" Margin="0,0,0,8" />

                                <Label Grid.Row="1" Grid.Column="0" Text="Batch Size" Style="{StaticResource FieldLabel}" Margin="0,0,10,4" />
                                <Entry Grid.Row="1" Grid.Column="1"
                                  Text="{Binding CurrentParameters.BatchSize, Converter={StaticResource IntNullableConverter}}"
                                  Style="{StaticResource FieldEntry}" Margin="0,0,0,4" />

                                <Label Grid.Row="2" Grid.Column="0" Text="Microbatch" Style="{StaticResource FieldLabel}" Margin="0,0,10,4" />
                                <Entry Grid.Row="2" Grid.Column="1"
                                  Text="{Binding CurrentParameters.UbatchSize, Converter={StaticResource IntNullableConverter}}"
                                  Style="{StaticResource FieldEntry}" Margin="0,0,0,4" />

                                <Label Grid.Row="3" Grid.Column="0" Text="Flash attention" Style="{StaticResource FieldLabel}" Margin="0,0,10,4" />
                                <Picker Grid.Row="3" Grid.Column="1"
                                   ItemsSource="{x:Static models:ProfileParameters.FlashAttnOptions}"
                                   SelectedItem="{Binding CurrentParameters.FlashAttn, Converter={StaticResource PickerDefaultConverter}}"
                                   Style="{StaticResource FieldPicker}" Margin="0,0,0,4" />

                                <Label Grid.Row="4" Grid.Column="0" Text="K-cache" Style="{StaticResource FieldLabel}" Margin="0,0,10,4" />
                                <Picker Grid.Row="4" Grid.Column="1"
                                   ItemsSource="{x:Static models:ProfileParameters.CacheTypeOptions}"
                                   SelectedItem="{Binding CurrentParameters.CacheTypeK, Converter={StaticResource PickerDefaultConverter}}"
                                   Style="{StaticResource FieldPicker}" Margin="0,0,0,4" />

                                <Label Grid.Row="5" Grid.Column="0" Text="V-cache" Style="{StaticResource FieldLabel}" Margin="0,0,10,4" />
                                <Picker Grid.Row="5" Grid.Column="1"
                                   ItemsSource="{x:Static models:ProfileParameters.CacheTypeOptions}"
                                   SelectedItem="{Binding CurrentParameters.CacheTypeV, Converter={StaticResource PickerDefaultConverter}}"
                                    Style="{StaticResource FieldPicker}" Margin="0,0,0,4" />

                                <Label Grid.Row="6" Grid.Column="0" Text="Metrics endpoint" Style="{StaticResource FieldLabel}" Margin="0,0,10,4" />
                                <CheckBox Grid.Row="6" Grid.Column="1"
                                      IsChecked="{Binding CurrentParameters.EnableMetrics, Converter={StaticResource BoolNullableConverter}}"
                                      VerticalOptions="Center" Margin="0,0,0,4"
                                      SemanticProperties.Hint="--metrics in the startup command (default off in llama-server; required for the metrics cards on the Overview page)" />
                            </Grid>

                            <!-- Speculation / MTP -->
                            <Grid Grid.Row="3" Margin="0,14,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Label Grid.Row="0" Grid.ColumnSpan="2" Text="Speculation / MTP" Style="{StaticResource SectionTitle}" FontSize="15" Margin="0,0,0,8" />

                                <Label Grid.Row="1" Grid.Column="0" Text="Spec type" Style="{StaticResource FieldLabel}" Margin="0,0,10,4" />
                                <Picker Grid.Row="1" Grid.Column="1"
                                   ItemsSource="{x:Static models:ProfileParameters.SpecTypeOptions}"
                                   SelectedItem="{Binding CurrentParameters.SpecType, Converter={StaticResource PickerDefaultConverter}}"
                                   Style="{StaticResource FieldPicker}" Margin="0,0,0,4" />

                                <Label Grid.Row="2" Grid.Column="0" Text="Spec draft n-max" Style="{StaticResource FieldLabel}" Margin="0,0,10,4" />
                                <Entry Grid.Row="2" Grid.Column="1"
                                  Text="{Binding CurrentParameters.SpecDraftNMax, Converter={StaticResource IntNullableConverter}}"
                                  Style="{StaticResource FieldEntry}" Margin="0,0,0,4" />

                                <Label Grid.Row="3" Grid.Column="0" Text="Spec draft device" Style="{StaticResource FieldLabel}" Margin="0,0,10,4" />
                                <Entry Grid.Row="3" Grid.Column="1"
                                  Text="{Binding CurrentParameters.SpecDraftDevice}"
                                  Style="{StaticResource FieldEntry}" Margin="0,0,0,4"
                                  Placeholder="cpu,0,1" />
                            </Grid>

                            <!-- Vision (only visible for LikelyVision of the selected model) -->
                            <Grid Grid.Row="4" Margin="0,14,0,0"
                              IsVisible="{Binding SelectedModelHasVision, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Label Grid.Row="0" Grid.ColumnSpan="2" Text="Vision" Style="{StaticResource SectionTitle}" FontSize="15" Margin="0,0,0,8" />

                                <Label Grid.Row="1" Grid.Column="0" Text="MM projector" Style="{StaticResource FieldLabel}" Margin="0,0,10,4" />
                                <Picker Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{x:Static vm:ModelsViewModel.MmprojModeOptions}"
                                  SelectedItem="{Binding MmprojMode, Converter={StaticResource MmprojModePickerConverter}}"
                                  Style="{StaticResource FieldPicker}" Margin="0,0,0,4" />

                                <!-- Explicit path (Custom mode only): typeable entry + browse button -->
                                <Label Grid.Row="2" Grid.Column="0" Text="Custom path" Style="{StaticResource FieldLabel}" Margin="0,0,10,4"
                                  IsVisible="{Binding MmprojMode, Converter={StaticResource MmprojModeCustomToVisibilityConverter}}" />
                                <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,4"
                                  IsVisible="{Binding MmprojMode, Converter={StaticResource MmprojModeCustomToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Entry Grid.Column="0"
                                      Text="{Binding CurrentParameters.MmprojPath}"
                                      Style="{StaticResource FieldEntry}" Margin="0,0,8,0"
                                      Placeholder="path to .gguf (mmproj)" />
                                    <Button Grid.Column="1" Text="Browse…" Style="{StaticResource RowButton}"
                                      SemanticProperties.Hint="Choose an mmproj GGUF file"
                                      Command="{Binding PickMmprojFileCommand}"
                                      IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                                </Grid>

                                <Label Grid.Row="3" Grid.Column="0" Text="Effective" Style="{StaticResource FieldLabel}" Margin="0,0,10,4" />
                                <Label Grid.Row="3" Grid.Column="1"
                                  Text="{Binding MmprojEffectivePath}"
                                  FontFamily="Consolas" FontSize="13" VerticalOptions="Center"
                                  Margin="0,0,0,4" />

                                <Label Grid.Row="4" Grid.Column="0" Text="Image min" Style="{StaticResource FieldLabel}" Margin="0,0,10,4" />
                                <Entry Grid.Row="4" Grid.Column="1"
                                  Text="{Binding CurrentParameters.ImageMinTokens, Converter={StaticResource IntNullableConverter}}"
                                  Style="{StaticResource FieldEntry}" Margin="0,0,0,4" />

                                <Label Grid.Row="5" Grid.Column="0" Text="No offload" Style="{StaticResource FieldLabel}" Margin="0,0,10,4" />
                                <CheckBox Grid.Row="5" Grid.Column="1"
                                      IsChecked="{Binding CurrentParameters.NoMmprojOffload, Converter={StaticResource BoolNullableConverter}}"
                                      VerticalOptions="Center" Margin="0,0,0,4"
                                      SemanticProperties.Hint="--no-mmproj-offload: don't offload mmproj to GPU (default: offload on)" />
                            </Grid>

                            <!-- Thinking (chat-template-kwargs) -->
                            <Grid Grid.Row="5" Margin="0,14,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Label Grid.Row="0" Grid.ColumnSpan="2" Text="Thinking" Style="{StaticResource SectionTitle}" FontSize="15" Margin="0,0,0,8" />

                                <Label Grid.Row="1" Grid.Column="0" Text="Thinking" Style="{StaticResource FieldLabel}" Margin="0,0,10,4" />
                                <Picker Grid.Row="1" Grid.Column="1"
                                    ItemsSource="{x:Static models:ProfileParameters.ThinkingOptions}"
                                    SelectedItem="{Binding CurrentParameters.ThinkingLevel, Converter={StaticResource PickerDefaultConverter}}"
                                    Style="{StaticResource FieldPicker}" Margin="0,0,0,4" />
                            </Grid>

                            <!-- Generation defaults -->
                            <Grid Grid.Row="6" Margin="0,14,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Label Grid.Row="0" Grid.ColumnSpan="2" Text="Generation Defaults" Style="{StaticResource SectionTitle}" FontSize="15" Margin="0,0,0,8" />

                                <Label Grid.Row="1" Grid.Column="0" Text="Temperature" Style="{StaticResource FieldLabel}" Margin="0,0,10,4" />
                                <Entry Grid.Row="1" Grid.Column="1"
                                  Text="{Binding CurrentParameters.Temperature, Converter={StaticResource DoubleNullableConverter}}"
                                  Style="{StaticResource FieldEntry}" Margin="0,0,0,4" />

                                <Label Grid.Row="2" Grid.Column="0" Text="Top K" Style="{StaticResource FieldLabel}" Margin="0,0,10,4" />
                                <Entry Grid.Row="2" Grid.Column="1"
                                  Text="{Binding CurrentParameters.TopK, Converter={StaticResource IntNullableConverter}}"
                                  Style="{StaticResource FieldEntry}" Margin="0,0,0,4" />

                                <Label Grid.Row="3" Grid.Column="0" Text="Top P" Style="{StaticResource FieldLabel}" Margin="0,0,10,4" />
                                <Entry Grid.Row="3" Grid.Column="1"
                                  Text="{Binding CurrentParameters.TopP, Converter={StaticResource DoubleNullableConverter}}"
                                  Style="{StaticResource FieldEntry}" Margin="0,0,0,4" />

                                <Label Grid.Row="4" Grid.Column="0" Text="Min P" Style="{StaticResource FieldLabel}" Margin="0,0,10,4" />
                                <Entry Grid.Row="4" Grid.Column="1"
                                  Text="{Binding CurrentParameters.MinP, Converter={StaticResource DoubleNullableConverter}}"
                                  Style="{StaticResource FieldEntry}" Margin="0,0,0,4" />

                                <Label Grid.Row="5" Grid.Column="0" Text="Presence penalty" Style="{StaticResource FieldLabel}" Margin="0,0,10,4" />
                                <Entry Grid.Row="5" Grid.Column="1"
                                  Text="{Binding CurrentParameters.PresencePenalty, Converter={StaticResource DoubleNullableConverter}}"
                                  Style="{StaticResource FieldEntry}" Margin="0,0,0,4" />

                                <Label Grid.Row="6" Grid.Column="0" Text="Repeat penalty" Style="{StaticResource FieldLabel}" Margin="0,0,10,4" />
                                <Entry Grid.Row="6" Grid.Column="1"
                                  Text="{Binding CurrentParameters.RepeatPenalty, Converter={StaticResource DoubleNullableConverter}}"
                                  Style="{StaticResource FieldEntry}" Margin="0,0,0,4" />

                                <Label Grid.Row="7" Grid.Column="0" Text="Jinja chat" Style="{StaticResource FieldLabel}" Margin="0,0,10,4" />
                                <CheckBox Grid.Row="7" Grid.Column="1"
                                      IsChecked="{Binding CurrentParameters.Jinja, Converter={StaticResource BoolNullableConverter}}"
                                      VerticalOptions="Center" Margin="0,0,0,4" />
                            </Grid>

                            <!-- Runtime Command (read-only preview) -->
                            <Grid Grid.Row="7" Margin="0,14,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                            </Grid>

                        </Grid>
                    </ScrollView>

                    <!-- Bottom: Save / Delete — always visible -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" RowSpacing="8" ColumnSpacing="8" Margin="0,8,0,0" RowDefinitions="auto,auto,auto"
                          IsVisible="{Binding SelectedProfile, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Label Grid.Column="0"
                                       Text="Runtime Command"
                                       Style="{StaticResource SectionTitle}"
                                       FontSize="15"
                                       Margin="0,0,0,8" />
                                    <!-- Copy button: copies the runtime command preview to the clipboard
                                         (green check for a few seconds after a successful copy). -->
                                    <controls:CopyIconButton Grid.Column="1" HorizontalOptions="End"
                                           Text="{Binding CommandPreview, Mode=OneWay}"
                                           FontSize="14"
                                           VerticalOptions="Center"
                                           Margin="8,0,0,8" />
                                <Editor Grid.Row="1" Grid.ColumnSpan="2"
                                    Text="{Binding CommandPreview, Mode=OneWay}"
                                    IsReadOnly="True"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    AutoSize="TextChanges"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                                    TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                        <Button Grid.Column="0" Grid.Row="2"
                                Text="Save"
                                SemanticProperties.Hint="Save the launch settings as a JSON blob"
                                Command="{Binding SaveProfileCommand}" />
                        <Button Grid.Column="1" Grid.Row="2"
                                Text="Delete"
                                Style="{StaticResource DangerButton}"
                                MinimumHeightRequest="44"
                                IsEnabled="{Binding SelectedProfile.IsDefault, Converter={StaticResource InvertedBoolConverter}}"
                                SemanticProperties.Hint="Delete the selected profile (Default cannot be deleted)"
                                Command="{Binding DeleteProfileCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status line -->
        <Label Grid.Row="2"
               Text="{Binding StatusText}"
               Style="{StaticResource SectionSubtitle}"
               Margin="4,10,0,0"
               LineBreakMode="CharacterWrap" />
    </Grid>
</ContentPage>
