<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LlamaCppStarterApp.ViewModels"
             xmlns:models="clr-namespace:LlamaCppStarterApp.Models"
             xmlns:behaviors="clr-namespace:LlamaCppStarterApp.Behaviors"
             x:DataType="vm:OverviewViewModel"
             x:Class="LlamaCppStarterApp.Views.OverviewPage">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="20,16" RowSpacing="12">

        <!-- Topbar: model / profile / runtime dropdowns + Load/Unload -->
        <Grid ColumnDefinitions="*,auto" ColumnSpacing="12">
            <Border Grid.Row="0" Style="{StaticResource PanelBorder}">
                <Grid RowDefinitions="Auto,Auto, Auto" RowSpacing="8">
                    <!-- Title row: "llama.cpp" + right-aligned server link (http://{host}:{port}) -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto">
                        <BoxView Grid.Column="0"
                             WidthRequest="4"
                             HeightRequest="20"
                             CornerRadius="2"
                             BackgroundColor="{StaticResource Primary}"
                             Margin="0,0,10,0"
                             VerticalOptions="Center" />
                        <Label Grid.Column="1"
                           Text="llama.cpp"
                           Style="{StaticResource SectionTitle}" />
                        <HorizontalStackLayout Grid.Column="3" behaviors:CursorBehavior.Cursor="Hand">
                            <!-- Server link: underline + hand cursor on hover; tap opens it in the default browser -->
                            <Label
                               Text="{Binding ServerUrl}"
                               TextDecorations="Underline"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource MidnightBlue}, Dark={StaticResource White}}"
                               HorizontalOptions="End"
                               VerticalOptions="Center"
                               Margin="16,0,0,0"
                               IsVisible="{Binding ServerUrl, Converter={StaticResource StringToVisibilityConverter}}"
                               SemanticProperties.Description="Open the llama.cpp server in the browser"
                               />
                            <Label
                               Text="&#xf35d;"
                               FontFamily="FontAwesomeSolid"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource MidnightBlue}, Dark={StaticResource White}}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Margin="8,2,10,0" />

                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenServerUrlCommand}" />
                            </HorizontalStackLayout.GestureRecognizers>
                            
                        </HorizontalStackLayout>
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,2*,2*,3*,Auto" ColumnSpacing="8">
                        <!-- Running-indicator dot: green = server running/starting/stopping, gray = stopped -->
                        <BoxView Grid.Column="0"
                             WidthRequest="10"
                             HeightRequest="10"
                             CornerRadius="5"
                             BackgroundColor="{Binding IsRunning, Converter={StaticResource BoolToColorConverter}}"
                             SemanticProperties.Description="Modelstatus-indicator"
                             Margin="7,20,10,0"
                             VerticalOptions="Center" />
                        <Picker Grid.Column="1"
                            Title="Model"
                            ItemsSource="{Binding Models}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedModel}"
                            Style="{StaticResource FieldPicker}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                        <Picker Grid.Column="2"
                            Title="Startprofiel"
                            ItemsSource="{Binding Profiles}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedProfile}"
                            Style="{StaticResource FieldPicker}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                        <Picker Grid.Column="3"
                            Title="Runtime"
                            ItemsSource="{Binding Runtimes}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedRuntime}"
                            Style="{StaticResource FieldPicker}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource PanelBorder}">
                <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center" Grid.RowSpan="3">
                    <Button Text="{Binding LoadButtonText}" WidthRequest="160"
                            SemanticProperties.Hint="Laad de geselecteerde combinatie; een draaiende server wordt eerst gestopt"
                            Command="{Binding LoadCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                    <Button Text="Unload" WidthRequest="160"
                            Style="{StaticResource RowButton}"
                            MinimumHeightRequest="44"
                            IsEnabled="{Binding IsRunning}"
                            SemanticProperties.Hint="Stop de draaiende llama-server"
                            Command="{Binding UnloadCommand}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Sub top bar: Command -->
        <Border Grid.Row="1" Style="{StaticResource PanelBorder}">
            <Grid RowDefinitions="Auto,Auto, Auto" RowSpacing="8">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                    <BoxView Grid.Column="0"
                     WidthRequest="4"
                     HeightRequest="20"
                     CornerRadius="2"
                     BackgroundColor="{StaticResource Primary}"
                     Margin="0,0,10,0"
                     VerticalOptions="Center" />
                    <Label Grid.Column="1"
                       Text="Command"
                       Style="{StaticResource SectionTitle}" />
                </Grid>

                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
                    <Label Grid.Column="1"
                   Text="{Binding CommandPreview, Mode=OneWay}"
                   FontFamily="Consolas"
                   FontSize="12"
                   VerticalOptions="Center"
                   LineBreakMode="CharacterWrap"
                   Margin="8,0" />
                    <ActivityIndicator Grid.Column="2"
                               IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                               VerticalOptions="Center" />
                </Grid>
            </Grid>
        </Border>

        <!-- Middle: 6 status cards (3×2 grid; MAUI has no UniformGrid → Grid *) -->
        <Grid Grid.Row="2"
              RowDefinitions="*,*"
              ColumnDefinitions="2*,2*,*"
              ColumnSpacing="12"
              RowSpacing="12">

            <!-- Card 1: Modelstatus (local status state) -->
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PanelBorder}">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                        <!-- Accent: green while a server is running, Primary when stopped -->
                        <BoxView Grid.Column="0"
                                 WidthRequest="4"
                                 HeightRequest="20"
                                 CornerRadius="2"
                                 BackgroundColor="{Binding IsRunning, Converter={StaticResource BoolToColorConverter}}"
                                 Margin="0,0,10,0"
                                 VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Modelstatus"
                               Style="{StaticResource SectionTitle}" />
                    </Grid>
                    <Label Grid.Row="1"
                           Text="{Binding ModelStatusText}"
                           FontSize="13"
                           LineBreakMode="CharacterWrap"
                           VerticalOptions="Center"
                           Margin="0,10,0,0" />
                </Grid>
            </Border>

            <!-- Card 2: Hardware (nvidia-smi) -->
            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource PanelBorder}">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                        <BoxView Grid.Column="0"
                                 WidthRequest="4"
                                 HeightRequest="20"
                                 CornerRadius="2"
                                 BackgroundColor="{StaticResource Primary}"
                                 Margin="0,0,10,0"
                                 VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Hardware"
                               Style="{StaticResource SectionTitle}" />
                    </Grid>
                    <Grid Grid.Row="1" RowDefinitions="Auto,Auto" Margin="0,10,0,0">
                        <!-- Pre-first-probe / no-GPU placeholder -->
                        <Label Grid.Row="0"
                               Text="Unavailable"
                               FontSize="13"
                               IsVisible="{Binding HardwareUnavailable, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <!-- One row per GPU (max 4): id + name | usage | temp | memory + 2 bars -->
                        <CollectionView Grid.Row="1"
                                        ItemsSource="{Binding HardwareGpus}"
                                        IsVisible="{Binding HardwareUnavailable, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:GpuSummary">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,*,auto"
                                          ColumnSpacing="10"
                                          Margin="0,5">
                                        <Label Grid.Column="0"
                                               Text="{Binding DisplayText}"
                                               FontSize="12" WidthRequest="190"
                                               LineBreakMode="CharacterWrap"
                                               VerticalOptions="Center" />
                                        <ProgressBar Grid.Column="1"
                                                     Progress="{Binding GpuUsageBarValue}"
                                                     HeightRequest="8"
                                                     HorizontalOptions="Fill"
                                                     ProgressColor="{StaticResource StatusActive}" />
                                        <Label Grid.Column="2"
                                               Text="{Binding UsageText}"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               LineBreakMode="CharacterWrap"
                                               VerticalOptions="Center" />
                                        <Label Grid.Column="3"
                                               Text="{Binding TemperatureText}"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               LineBreakMode="CharacterWrap"
                                               VerticalOptions="Center" />
                                        <ProgressBar Grid.Column="4"
                                                     Progress="{Binding MemoryUsedBarValue}"
                                                     HeightRequest="8"
                                                     HorizontalOptions="Fill"
                                                     ProgressColor="{StaticResource Primary}" />
                                        <Label Grid.Column="5"
                                               Text="{Binding MemoryText}"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               LineBreakMode="CharacterWrap"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Grid>
            </Border>

            <!-- Card 3: Stats (/slots) -->
            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource PanelBorder}">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                        <BoxView Grid.Column="0"
                                 WidthRequest="4"
                                 HeightRequest="20"
                                 CornerRadius="2"
                                 BackgroundColor="{StaticResource Primary}"
                                 Margin="0,0,10,0"
                                 VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Stats"
                               Style="{StaticResource SectionTitle}" />
                    </Grid>
                    <Label Grid.Row="1"
                           Text="{Binding StatsText}"
                           FontFamily="Consolas"
                           FontSize="13"
                           LineBreakMode="CharacterWrap"
                           VerticalOptions="Center"
                           Margin="0,10,0,0" />
                </Grid>
            </Border>

            <!-- Card 4: Tokens (/metrics) -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource PanelBorder}">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                        <BoxView Grid.Column="0"
                                 WidthRequest="4"
                                 HeightRequest="20"
                                 CornerRadius="2"
                                 BackgroundColor="{StaticResource Primary}"
                                 Margin="0,0,10,0"
                                 VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Tokens"
                               Style="{StaticResource SectionTitle}" />
                    </Grid>
                    <Label Grid.Row="1"
                           Text="{Binding TokensText}"
                           FontFamily="Consolas"
                           FontSize="13"
                           LineBreakMode="CharacterWrap"
                           VerticalOptions="Center"
                           Margin="0,10,0,0" />
                </Grid>
            </Border>

            <!-- Card 5: MTP tokens (/metrics) -->
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PanelBorder}">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                        <BoxView Grid.Column="0"
                                 WidthRequest="4"
                                 HeightRequest="20"
                                 CornerRadius="2"
                                 BackgroundColor="{StaticResource Primary}"
                                 Margin="0,0,10,0"
                                 VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="MTP-tokens"
                               Style="{StaticResource SectionTitle}" />
                    </Grid>
                    <Label Grid.Row="1"
                           Text="{Binding MtpTokensText}"
                           FontFamily="Consolas"
                           FontSize="13"
                           LineBreakMode="CharacterWrap"
                           VerticalOptions="Center"
                           Margin="0,10,0,0" />
                </Grid>
            </Border>

            <!-- Card 6: KV cache (/metrics + /slots fallback) -->
            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource PanelBorder}">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                        <BoxView Grid.Column="0"
                                 WidthRequest="4"
                                 HeightRequest="20"
                                 CornerRadius="2"
                                 BackgroundColor="{StaticResource Primary}"
                                 Margin="0,0,10,0"
                                 VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="KV-cache"
                               Style="{StaticResource SectionTitle}" />
                    </Grid>
                    <VerticalStackLayout Grid.Row="1"
                                         Spacing="10"
                                         VerticalOptions="Center"
                                         Margin="0,10,0,0">
                        <Label Text="{Binding KvCacheText}"
                               FontFamily="Consolas"
                               FontSize="13"
                               LineBreakMode="CharacterWrap" />
                        <ProgressBar Progress="{Binding KvCacheBarValue}"
                                     HeightRequest="8"
                                     HorizontalOptions="Fill"
                                     ProgressColor="{StaticResource StatusActive}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>

        <!-- Live runtime log -->
        <Border Grid.Row="3" Style="{StaticResource PanelBorder}">
            <Grid RowDefinitions="Auto,*,Auto" >
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                    <BoxView Grid.Column="0"
                             WidthRequest="4"
                             HeightRequest="20"
                             CornerRadius="2"
                             BackgroundColor="{StaticResource Primary}"
                             Margin="0,0,10,0"
                             VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="Live runtime-logboek"
                           Style="{StaticResource SectionTitle}" />
                </Grid>
                <Label Grid.Row="2"
                       Text="{Binding StatusText}"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource MidnightBlue}, Dark={StaticResource White}}"
                       Margin="14,12,0,0" />
                <Border Grid.Row="1"
                        BackgroundColor="#1E1E1E"
                        StrokeThickness="0" Padding="6"
                        StrokeShape="RoundRectangle 6"
                        Margin="0,6,0,0">
                    <CollectionView 
                                    ItemsSource="{Binding LogLines, Mode=OneWay}"
                                    ItemsUpdatingScrollMode="KeepLastItemInView"
                                    SelectionMode="None"
                                    VerticalScrollBarVisibility="Always"
                                    BackgroundColor="Transparent">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Text="{Binding ., Mode=OneTime}"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       TextColor="#D4D4D4"
                                       Padding="8,2" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <Label Text="Nog geen output..." TextColor="Gray"
                                   HorizontalOptions="Center" VerticalOptions="Center" Margin="20" />
                        </CollectionView.EmptyView>
                    </CollectionView>
                </Border>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
