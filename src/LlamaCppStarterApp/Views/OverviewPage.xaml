<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LlamaCppStarterApp.ViewModels"
                          x:DataType="vm:OverviewViewModel"
             x:Class="LlamaCppStarterApp.Views.OverviewPage"
             Title="Overzicht">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20,16">

        <!-- Topbar: model / profiel / runtime dropdowns + Laden/Unload -->
        <Border Grid.Row="0" Style="{StaticResource PanelBorder}">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                <Grid Grid.Row="0" ColumnDefinitions="2*,2*,3*,Auto" ColumnSpacing="8">
                    <Picker Grid.Column="0"
                            Title="Model"
                            ItemsSource="{Binding Models}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedModel}"
                            Style="{StaticResource FieldPicker}" />
                    <Picker Grid.Column="1"
                            Title="Startprofiel"
                            ItemsSource="{Binding Profiles}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedProfile}"
                            Style="{StaticResource FieldPicker}" />
                    <Picker Grid.Column="2"
                            Title="Runtime"
                            ItemsSource="{Binding Runtimes}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedRuntime}"
                            Style="{StaticResource FieldPicker}" />
                    <StackLayout Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalOptions="Center">
                        <Button Text="Laden"
                                SemanticProperties.Hint="Start de llama-server met het geselecteerde model, profiel en runtime"
                                Command="{Binding LoadCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                        <Button Text="Unload"
                                Style="{StaticResource RowButton}"
                                MinimumHeightRequest="44"
                                IsEnabled="{Binding IsRunning}"
                                SemanticProperties.Hint="Stop de draaiende llama-server"
                                Command="{Binding UnloadCommand}" />
                    </StackLayout>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
                    <Label Grid.Column="0"
                           Text="Modelmap:"
                           Style="{StaticResource FieldLabel}" />
                    <Label Grid.Column="1"
                           Text="{Binding ModelsFolder}"
                           FontFamily="Consolas"
                           FontSize="12"
                           VerticalOptions="Center"
                           LineBreakMode="CharacterWrap"
                           Margin="8,0" />
                    <ActivityIndicator Grid.Column="2"
                                       IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                                       VerticalOptions="Center" />
                </Grid>
            </Grid>
        </Border>

        <!-- Midden: 6 status-kaarten (3×2 raster; MAUI heeft geen UniformGrid → Grid *) -->
        <Grid Grid.Row="1"
              RowDefinitions="*,*"
              ColumnDefinitions="*,*,*"
              ColumnSpacing="12"
              RowSpacing="12"
              Margin="0,12,0,0">

            <!-- Kaart 1: Modelstatus (lokaal status-state) -->
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PanelBorder}">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                        <BoxView Grid.Column="0"
                                 WidthRequest="4"
                                 HeightRequest="20"
                                 CornerRadius="2"
                                 BackgroundColor="{StaticResource Primary}"
                                 Margin="0,0,10,0"
                                 VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Modelstatus"
                               Style="{StaticResource SectionTitle}" />
                    </Grid>
                    <Label Grid.Row="1"
                           Text="{Binding ModelStatusText}"
                           FontSize="13"
                           LineBreakMode="CharacterWrap"
                           VerticalOptions="Center"
                           Margin="0,10,0,0" />
                </Grid>
            </Border>

            <!-- Kaart 2: Hardware (nvidia-smi) -->
            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource PanelBorder}">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                        <BoxView Grid.Column="0"
                                 WidthRequest="4"
                                 HeightRequest="20"
                                 CornerRadius="2"
                                 BackgroundColor="{StaticResource Primary}"
                                 Margin="0,0,10,0"
                                 VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Hardware"
                               Style="{StaticResource SectionTitle}" />
                    </Grid>
                    <Label Grid.Row="1"
                           Text="{Binding HardwareText}"
                           FontSize="13"
                           LineBreakMode="CharacterWrap"
                           VerticalOptions="Center"
                           Margin="0,10,0,0" />
                </Grid>
            </Border>

            <!-- Kaart 3: Stats (/slots) -->
            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource PanelBorder}">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                        <BoxView Grid.Column="0"
                                 WidthRequest="4"
                                 HeightRequest="20"
                                 CornerRadius="2"
                                 BackgroundColor="{StaticResource Primary}"
                                 Margin="0,0,10,0"
                                 VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Stats"
                               Style="{StaticResource SectionTitle}" />
                    </Grid>
                    <Label Grid.Row="1"
                           Text="{Binding StatsText}"
                           FontFamily="Consolas"
                           FontSize="13"
                           LineBreakMode="CharacterWrap"
                           VerticalOptions="Center"
                           Margin="0,10,0,0" />
                </Grid>
            </Border>

            <!-- Kaart 4: Tokens (/metrics) -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource PanelBorder}">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                        <BoxView Grid.Column="0"
                                 WidthRequest="4"
                                 HeightRequest="20"
                                 CornerRadius="2"
                                 BackgroundColor="{StaticResource Primary}"
                                 Margin="0,0,10,0"
                                 VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Tokens"
                               Style="{StaticResource SectionTitle}" />
                    </Grid>
                    <Label Grid.Row="1"
                           Text="{Binding TokensText}"
                           FontFamily="Consolas"
                           FontSize="13"
                           LineBreakMode="CharacterWrap"
                           VerticalOptions="Center"
                           Margin="0,10,0,0" />
                </Grid>
            </Border>

            <!-- Kaart 5: MTP-tokens (/metrics) -->
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PanelBorder}">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                        <BoxView Grid.Column="0"
                                 WidthRequest="4"
                                 HeightRequest="20"
                                 CornerRadius="2"
                                 BackgroundColor="{StaticResource Primary}"
                                 Margin="0,0,10,0"
                                 VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="MTP-tokens"
                               Style="{StaticResource SectionTitle}" />
                    </Grid>
                    <Label Grid.Row="1"
                           Text="{Binding MtpTokensText}"
                           FontFamily="Consolas"
                           FontSize="13"
                           LineBreakMode="CharacterWrap"
                           VerticalOptions="Center"
                           Margin="0,10,0,0" />
                </Grid>
            </Border>

            <!-- Kaart 6: KV-cache (/metrics + /slots-fallback) -->
            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource PanelBorder}">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                        <BoxView Grid.Column="0"
                                 WidthRequest="4"
                                 HeightRequest="20"
                                 CornerRadius="2"
                                 BackgroundColor="{StaticResource Primary}"
                                 Margin="0,0,10,0"
                                 VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="KV-cache"
                               Style="{StaticResource SectionTitle}" />
                    </Grid>
                    <Label Grid.Row="1"
                           Text="{Binding KvCacheText}"
                           FontFamily="Consolas"
                           FontSize="13"
                           LineBreakMode="CharacterWrap"
                           VerticalOptions="Center"
                           Margin="0,10,0,0" />
                </Grid>
            </Border>
        </Grid>

        <!-- Live runtime-logboek -->
        <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Margin="0,12,0,0">
            <Grid RowDefinitions="Auto,Auto,Auto" HeightRequest="180">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                    <BoxView Grid.Column="0"
                             WidthRequest="4"
                             HeightRequest="20"
                             CornerRadius="2"
                             BackgroundColor="{StaticResource Primary}"
                             Margin="0,0,10,0"
                             VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="Live runtime-logboek"
                           Style="{StaticResource SectionTitle}" />
                </Grid>
                <Label Grid.Row="1"
                       Text="{Binding StatusText}"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource MidnightBlue}, Dark={StaticResource White}}"
                       Margin="14,6,0,0" />
                <Border Grid.Row="2"
                        BackgroundColor="#1E1E1E"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 6"
                        Margin="14,6,0,0">
                    <ScrollView HeightRequest="90">
                        <Label Text="{Binding LogText}" Style="{StaticResource LogLabel}" Padding="8" />
                    </ScrollView>
                </Border>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
