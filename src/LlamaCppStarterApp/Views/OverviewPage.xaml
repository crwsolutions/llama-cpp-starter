<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LlamaCppStarterApp.ViewModels"
             xmlns:models="clr-namespace:LlamaCppStarterApp.Models"
             x:DataType="vm:OverviewViewModel"
             x:Class="LlamaCppStarterApp.Views.OverviewPage"
             Title="Overzicht">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20,16">

        <!-- Topbar: model / profiel / runtime dropdowns + Laden/Unload -->
        <Border Grid.Row="0" Style="{StaticResource PanelBorder}">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                <Grid Grid.Row="0" ColumnDefinitions="2*,2*,3*,Auto" ColumnSpacing="8">
                    <Picker Grid.Column="0"
                            Title="Model"
                            ItemsSource="{Binding Models}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedModel}"
                            Style="{StaticResource FieldPicker}" />
                    <Picker Grid.Column="1"
                            Title="Startprofiel"
                            ItemsSource="{Binding Profiles}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedProfile}"
                            Style="{StaticResource FieldPicker}" />
                    <Picker Grid.Column="2"
                            Title="Runtime"
                            ItemsSource="{Binding Runtimes}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedRuntime}"
                            Style="{StaticResource FieldPicker}" />
                    <StackLayout Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalOptions="Center">
                        <Button Text="Laden"
                                SemanticProperties.Hint="Start de llama-server met het geselecteerde model, profiel en runtime"
                                Command="{Binding LoadCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                        <Button Text="Unload"
                                Style="{StaticResource RowButton}"
                                MinimumHeightRequest="44"
                                IsEnabled="{Binding IsRunning}"
                                SemanticProperties.Hint="Stop de draaiende llama-server"
                                Command="{Binding UnloadCommand}" />
                    </StackLayout>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
                    <Label Grid.Column="0"
                           Text="Modelmap:"
                           Style="{StaticResource FieldLabel}" />
                    <Label Grid.Column="1"
                           Text="{Binding ModelsFolder}"
                           FontFamily="Consolas"
                           FontSize="12"
                           VerticalOptions="Center"
                           LineBreakMode="CharacterWrap"
                           Margin="8,0" />
                    <ActivityIndicator Grid.Column="2"
                                       IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                                       VerticalOptions="Center" />
                </Grid>
            </Grid>
        </Border>

        <!-- Midden: Modelbestanden + Live runtime-logboek -->
        <Grid Grid.Row="1" RowDefinitions="*,Auto" Margin="0,12,0,0" RowSpacing="12">

            <!-- Modelbestanden -->
            <Border Grid.Row="0" Style="{StaticResource PanelBorder}">
                <Grid RowDefinitions="Auto,Auto,Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                        <BoxView Grid.Column="0"
                                 WidthRequest="4"
                                 HeightRequest="20"
                                 CornerRadius="2"
                                 BackgroundColor="{StaticResource Primary}"
                                 Margin="0,0,10,0"
                                 VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Modelbestanden"
                               Style="{StaticResource SectionTitle}" />
                    </Grid>
                    <Label Grid.Row="1"
                           Text="Fysieke GGUF-bestanden die zijn gevonden in de modelfolder of geïmporteerd van een andere map."
                           Style="{StaticResource SectionSubtitle}"
                           Margin="14,4,0,0" />

                    <Grid Grid.Row="2"
                          ColumnDefinitions="4*,Auto,Auto,Auto,Auto"
                          Margin="0,12,0,4">
                        <Label Grid.Column="0" Text="Naam" Style="{StaticResource TableHeaderLabel}" />
                        <Label Grid.Column="1" Text="Kwantificatie" Style="{StaticResource TableHeaderLabel}" />
                        <Label Grid.Column="2" Text="Grootte" Style="{StaticResource TableHeaderLabel}" />
                        <Label Grid.Column="3" Text="Map openen" Style="{StaticResource TableHeaderLabel}" />
                        <Label Grid.Column="4" Text="Verwijderen" Style="{StaticResource TableHeaderLabel}" />
                    </Grid>

                    <CollectionView Grid.Row="3"
                                    ItemsSource="{Binding Models}"
                                    VerticalScrollBarVisibility="Always">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Model">
                                <Border Style="{StaticResource TableRowBorder}">
                                    <Grid ColumnDefinitions="4*,Auto,Auto,Auto,Auto">
                                        <Label Grid.Column="0"
                                               Text="{Binding Name}"
                                               Style="{StaticResource TableCell}"
                                               FontAttributes="Bold" />
                                        <Label Grid.Column="1"
                                               Text="{Binding Quant}"
                                               Style="{StaticResource TableCell}"
                                               Margin="8,0" />
                                        <Label Grid.Column="2"
                                               Text="{Binding SizeBytes, Converter={StaticResource SizeToGbConverter}}"
                                               Style="{StaticResource TableCell}"
                                               Margin="8,0" />
                                        <Button Grid.Column="3"
                                                Text="Open Folder"
                                                Style="{StaticResource RowButton}"
                                                Margin="8,0"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenFolderCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Grid.Column="4"
                                                Text="Delete"
                                                Style="{StaticResource DangerButton}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteModelCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>

            <!-- Live runtime-logboek -->
            <Border Grid.Row="1" Style="{StaticResource PanelBorder}">
                <Grid RowDefinitions="Auto,Auto,Auto" HeightRequest="180">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                        <BoxView Grid.Column="0"
                                 WidthRequest="4"
                                 HeightRequest="20"
                                 CornerRadius="2"
                                 BackgroundColor="{StaticResource Primary}"
                                 Margin="0,0,10,0"
                                 VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Live runtime-logboek"
                               Style="{StaticResource SectionTitle}" />
                    </Grid>
                    <Label Grid.Row="1"
                           Text="{Binding StatusText}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource MidnightBlue}, Dark={StaticResource White}}"
                           Margin="14,6,0,0" />
                    <Border Grid.Row="2"
                            BackgroundColor="#1E1E1E"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 6"
                            Margin="14,6,0,0">
                        <ScrollView HeightRequest="90">
                            <Label Text="{Binding LogText}" Style="{StaticResource LogLabel}" Padding="8" />
                        </ScrollView>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Opgeslagen modelvarianten -->
        <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Margin="0,12,0,0">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" HeightRequest="170">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                    <BoxView Grid.Column="0"
                             WidthRequest="4"
                             HeightRequest="20"
                             CornerRadius="2"
                             BackgroundColor="{StaticResource Primary}"
                             Margin="0,0,10,0"
                             VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="Opgeslagen modelvarianten"
                           Style="{StaticResource SectionTitle}" />
                    <Button Grid.Column="2"
                            Text="Add"
                            Style="{StaticResource RowButton}"
                            VerticalOptions="Center"
                            SemanticProperties.Hint="Nieuw profiel via het Modellen-scherm"
                            Command="{Binding AddProfileCommand}" />
                </Grid>
                <Label Grid.Row="1"
                       Text="Laadbare allassen gemaakt uit startinstellingen."
                       Style="{StaticResource SectionSubtitle}"
                       Margin="14,4,0,6" />

                <Grid Grid.Row="2" ColumnDefinitions="2*,3*,Auto,Auto" Margin="0,0,0,4">
                    <Label Grid.Column="0" Text="Naam" Style="{StaticResource TableHeaderLabel}" />
                    <Label Grid.Column="1" Text="Basismodel" Style="{StaticResource TableHeaderLabel}" />
                    <Label Grid.Column="2" Text="Poort" Style="{StaticResource TableHeaderLabel}" />
                    <Label Grid.Column="3" Text="Verwijderen" Style="{StaticResource TableHeaderLabel}" />
                </Grid>

                <CollectionView Grid.Row="3"
                                ItemsSource="{Binding Profiles}"
                                VerticalScrollBarVisibility="Always">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Profile">
                            <Border Style="{StaticResource TableRowBorder}">
                                <Grid ColumnDefinitions="2*,3*,Auto,Auto">
                                    <Label Grid.Column="0"
                                           Text="{Binding Name}"
                                           Style="{StaticResource TableCell}"
                                           FontAttributes="Bold" />
                                    <Label Grid.Column="1"
                                           Text="{Binding ModelName}"
                                           Style="{StaticResource TableCell}"
                                           Margin="8,0" />
                                    <Label Grid.Column="2"
                                           Text="{Binding Port}"
                                           Style="{StaticResource TableCell}"
                                           Margin="8,0" />
                                    <Button Grid.Column="3"
                                            Text="Delete"
                                            Style="{StaticResource DangerButton}"
                                            IsVisible="{Binding IsDefault, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteProfileCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
