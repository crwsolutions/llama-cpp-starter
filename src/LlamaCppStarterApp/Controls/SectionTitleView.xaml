<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:LlamaCppStarterApp.Controls"
             x:Class="LlamaCppStarterApp.Controls.SectionTitleView"
             x:Name="This"
             x:DataType="controls:SectionTitleView">
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"
          
          >
        <BoxView Grid.Column="0"
                 WidthRequest="4"
                 HeightRequest="20"
                 CornerRadius="2"
                 Background="{Binding AccentColor, Source={x:Reference This}}"
                 VerticalOptions="Center" />
        <Label Grid.Column="1"
               Text="{Binding Title, Source={x:Reference This}}"
               Style="{StaticResource SectionTitle}" />
    </Grid>
</ContentView>
